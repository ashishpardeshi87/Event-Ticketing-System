rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users: can read and write only their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Events: authenticated users can read; writes via backend/Admin SDK only
    match /events/{eventId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    // Pass types: authenticated users can read; writes via backend/Admin SDK only
    match /pass_types/{passId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    // User passes: users can read only their own; writes via backend/Admin SDK only
    match /user_passes/{passId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    
    // Teams: backend only (Admin SDK). Client must use API.
    match /teams/{teamId} {
      allow read, write: if false;
    }
    
    // Team members: backend only
    match /teamMembers/{memberId} {
      allow read, write: if false;
    }
    
    // Payments: backend only (Admin SDK)
    match /payments/{paymentId} {
      allow read, write: if false;
    }
    
    // Orders: backend only (payment flow)
    match /orders/{orderId} {
      allow read, write: if false;
    }
    
    // Refund requests: backend only
    match /refund_requests/{requestId} {
      allow read, write: if false;
    }
    
    // Registrations: backend only (Admin SDK)
    match /registrations/{registrationId} {
      allow read, write: if false;
    }
  }
}
